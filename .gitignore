# Local environment files
.vscode/
*.envs/
.venv/
*.env

# Ignoring the build files for latex
report/*.aux
report/*.log
report/*.out
report/*.gz

*__pycache__/

# Raw yearly accident CSVs are downloaded by src/fetch_data.py
data/raw/[0-9]*.csv

# Ignore everything in output/media that isn't in a subdirectory of output/media/videos
output/media/*
!output/media/videos/
output/media/videos/**/partial_movie_files/

# Cached artifacts are rebuilt by utils.cached
output/artifacts/*
!output/artifacts/.gitkeep

# Ignore MAC files
*.DS_Store

# Graphify
graphify-out/
*.ipynb.py
*.ipynb.md
*.ipynb.sql
*.ipynb.sh
*.ipynb.scala
*.ipynb.r